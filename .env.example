# Copy this file to .env and fill in at least one API key per section.
# .env is gitignored — never commit it.

# ── LLM providers ──────────────────────────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY="your_anthropic_key_here"

# OpenAI (GPT) — https://platform.openai.com
OPENAI_API_KEY="your_openai_key_here"

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY="your_gemini_key_here"

# ── Wazuh integration ───────────────────────────────────────────────────────────
WAZUH_URL="https://your-wazuh-instance:55000"
WAZUH_USER="wazuh-wui"
WAZUH_PASSWORD="your_wazuh_password"
WAZUH_VERIFY_SSL="true"   # set to "false" for self-signed certs

# ── Microsoft Sentinel integration ─────────────────────────────────────────────
SENTINEL_SUBSCRIPTION_ID="your_azure_subscription_id"
SENTINEL_RESOURCE_GROUP="your_resource_group"
SENTINEL_WORKSPACE_NAME="your_workspace_name"
# Service principal (optional — falls back to az CLI session if not set)
AZURE_TENANT_ID="your_tenant_id"
AZURE_CLIENT_ID="your_client_id"
AZURE_CLIENT_SECRET="your_client_secret"

# ── Splunk integration ──────────────────────────────────────────────────────────
SPLUNK_URL="https://your-splunk-instance:8089"
SPLUNK_USER="your_splunk_username"
SPLUNK_PASSWORD="your_splunk_password"
SPLUNK_VERIFY_SSL="true"   # set to "false" for self-signed certs
SPLUNK_QUERY=""            # optional — leave empty to use the default query
